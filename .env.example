# ============================================================================
# 🔧 ENVIRONMENT CONFIGURATION EXAMPLES
# ============================================================================
# Copy this file to `.env` and update values as needed
# Different scenarios are documented below
# ============================================================================

# ============================================================================
# SCENARIO 1: Local Development (App running locally, Docker databases)
# ============================================================================
# Run: docker-compose -f docker-compose.dev.yml --profile db up -d
# Then: pnpm run dev (in both frontend and backend)
#
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ifrspro_platform_admin
# LEGACY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frs9pro
# REDIS_URL=redis://localhost:6379

# ============================================================================
# SCENARIO 2: Docker App with External Databases
# ============================================================================
# Run: docker-compose -f docker-compose.dev.yml --profile app up -d
# Requires external database connection strings
#
# DATABASE_URL=postgresql://user:password@remote-host:5432/ifrspro_platform_admin
# LEGACY_DATABASE_URL=postgresql://user:password@remote-host:5432/frs9pro
# REDIS_URL=redis://remote-host:6379

# ============================================================================
# SCENARIO 3: Full Docker Environment
# ============================================================================
# Run: docker-compose -f docker-compose.dev.yml --profile full up -d
# All services in Docker, no external dependencies needed
# (Uses defaults from docker-compose.dev.yml)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ifrspro_platform_admin

# Main Database (Platform Admin)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ifrspro_platform_admin

# Legacy Database (FRS9PRO)
LEGACY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frs9pro

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=4232
HOST=0.0.0.0
LOG_LEVEL=debug

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:4232/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4232/api

# ============================================================================
# PRODUCTION OVERRIDES (for reference)
# ============================================================================
# NODE_ENV=production
# LOG_LEVEL=info
# JWT_SECRET=<generate-strong-secret-here>
# DATABASE_URL=postgresql://user:password@prod-host:5432/db
# REDIS_URL=redis://prod-host:6379
