  "test_sql": {
    "verify_role": "SELECT r.role_code, mp.permission_type\nFROM core.roles r\nJOIN core.menu_permissions mp ON mp.role_id = r.id AND mp.is_allowed = true\nWHERE r.role_code = '{ROLE}'\nAND mp.menu_item_id = (SELECT id FROM ifrspro_platform_admin.menu.menu_items WHERE name = '{MENU}' LIMIT 1)\nORDER BY mp.permission_type;",
    "count_role_menus": "SELECT r.role_code, COUNT(*) as total_perms\nFROM core.roles r\nJOIN core.menu_permissions mp ON mp.role_id = r.id AND mp.is_allowed = true\nWHERE r.role_code = '{ROLE}'\nGROUP BY r.role_code;",
    "check_no_access": "SELECT COUNT(*) as should_be_zero\nFROM core.roles r\nJOIN core.menu_permissions mp ON mp.role_id = r.id AND mp.is_allowed = true\nWHERE r.role_code = '{ROLE}'\nAND mp.menu_item_id = (SELECT id FROM ifrspro_platform_admin.menu.menu_items WHERE name = '{MENU}' LIMIT 1);"
  }
