{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "."
    },
    "include": [
        "*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "packages",
        "deployment_package",
        "dist",
        ".next"
    ]
}