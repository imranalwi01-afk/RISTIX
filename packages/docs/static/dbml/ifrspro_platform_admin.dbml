// DBDocs artifact for ifrspro_platform_admin

// Generated by scripts/build-dbml-artifacts.mjs



Project ifrspro_platform_admin {

  database_type: 'PostgreSQL'

  Note: 'Logical DBML view for ifrspro_platform_admin.'

}



Table platform_admin.tenants [note: 'Platform tenant registry used by platform sessions and global governance.'] {
  id uuid [pk, note: 'Primary key (UUID).']
  code varchar(50) [not null, unique, note: 'Unique tenant code in platform registry.']
  name varchar(255) [not null, note: 'Tenant display/business name.']
  slug varchar(100) [note: 'Slug used for platform-level tenant routing.']
  description text [note: 'Tenant description.']
  type varchar(50) [default: 'banking', note: 'Tenant type/category.']
  banking_mode varchar(20) [default: 'conventional', note: 'Banking mode profile.']
  settings text [default: '{}', note: 'Serialized settings payload in platform schema.']
  is_active boolean [not null, default: true, note: 'Tenant activation status at platform level.']
  created_at timestamptz [not null, default: `now()`, note: 'Row creation timestamp.']
  updated_at timestamptz [not null, default: `now()`, note: 'Row last update timestamp.']

  Indexes {
    (code) [name: 'platform_tenants_code_idx', unique]
    (slug) [name: 'platform_tenants_slug_idx']
    (is_active) [name: 'platform_tenants_active_idx']
  }
}

Table platform_admin.users [note: 'Platform-level users for platform admins/operators.'] {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary key (UUID).']
  username varchar(100) [not null, note: 'Platform login username.']
  email varchar(255) [not null, note: 'Platform login email.']
  password_hash varchar(255) [not null, note: 'Hashed password for authentication.']
  full_name varchar(200) [not null, note: 'Full name shown in platform UI.']
  employee_id varchar(50) [note: 'Optional employee identifier.']
  role varchar(100) [not null, note: 'Platform role code/name.']
  is_active boolean [default: true, note: 'Whether account is active.']
  last_login_at timestamptz [note: 'Last successful login timestamp.']
  failed_login_attempts integer [default: 0, note: 'Consecutive failed login attempts.']
  created_at timestamptz [default: `now()`, note: 'Row creation timestamp.']
  updated_at timestamptz [default: `now()`, note: 'Row last update timestamp.']
  user_role varchar(100) [note: 'Optional normalized user role field (legacy compatibility).']
  tenant_id uuid [note: 'Optional tenant linkage for scoped platform operators.']
  tenant_name varchar(255) [note: 'Optional tenant name snapshot.']

  Indexes {
    (role) [name: 'idx_users_role']
    (last_login_at) [name: 'idx_users_last_login']
    (is_active) [name: 'idx_users_is_active']
  }
}



