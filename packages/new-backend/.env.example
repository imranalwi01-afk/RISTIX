# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/ifrs9_iaf

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=24h

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Discord alerting (optional)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_DISCORD_TIMEOUT_MS=5000
ALERT_MIN_LEVEL=error
ALERT_THROTTLE_MS=60000
