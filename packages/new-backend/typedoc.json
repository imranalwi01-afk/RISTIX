{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "expand",
    "entryPoints": [
        "./src/services/*.ts",
        "./src/routes/*.ts",
        "./src/repositories/*.ts",
        "./src/db/schema/*.ts",
        "./src/lib/*.ts",
        "./src/queue/bull-setup.ts",
        "./src/app.ts"
    ],
    "out": "../../packages/docs/docs/backend-api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "theme": "default",
    "name": "Backend API Reference",
    "includeVersion": true,
    "readme": "none",
    "entryFileName": "index",
    "outputFileStrategy": "modules",
    "flattenOutputFiles": true,
    "membersWithOwnFile": [],
    "skipErrorChecking": true,
    "hideGenerator": true,
    "cleanOutputDir": true,
    "githubPages": false,
    "hideBreadcrumbs": true
}
