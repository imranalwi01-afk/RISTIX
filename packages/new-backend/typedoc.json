{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "./src/index.ts",
        "./src/services/*.ts",
        "./src/routes/*.ts",
        "./src/repositories/*.ts",
        "./src/db/schema/*.ts",
        "./src/lib/*.ts",
        "./src/app.ts"
    ],
    "out": "../../packages/docs/docs/backend-api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "theme": "default",
    "name": "Backend API Reference",
    "includeVersion": true,
    "readme": "README.md",
    "skipErrorChecking": true,
    "hideGenerator": true,
    "cleanOutputDir": true,
    "githubPages": false,
    "hideBreadcrumbs": true
}