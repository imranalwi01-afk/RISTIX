{
    "name": "@ifrs9/new-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "IFRS 9 Multi-Tenant Islamic Banking Platform Backend - Hono + Drizzle + Effect",
    "main": "src/index.ts",
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir ./dist --target=bun",
        "compile": "bun build src/index.ts --compile --outfile ./dist/server",
        "compile:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile ./dist/server-linux",
        "compile:docker": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile ./dist/server",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "bun test",
        "test:notifications": "bun test src/test/services/notifications.service.test.ts",
        "test:approval": "bun test src/test/lib/approval-helpers.test.ts src/test/services/permission-approval.service.test.ts",
        "test:repositories": "bun test src/test/repositories/tenant-db-routing-users.test.ts src/test/repositories/tenant-db-routing-others.test.ts",
        "test:services": "bun test src/test/services/notifications.service.test.ts src/test/services/users.service.test.ts src/test/services/rbac.service.test.ts",
        "test:routes": "bun test src/test/routes",
        "test:users-route-contract": "bun test src/test/routes/users.response-contract.test.ts",
        "test:auth-route-contract": "bun test src/test/routes/auth.response-contract.test.ts",
        "test:notifications-route-contract": "bun test src/test/routes/notifications.response-contract.test.ts",
        "test:approval-route-contract": "bun test src/test/routes/approval.response-contract.test.ts",
        "test:jobs-route-contract": "bun test src/test/routes/jobs.response-contract.test.ts",
        "test:ifrs9-route-contract": "bun test src/test/routes/ifrs9.response-contract.test.ts",
        "test:approval-service": "bun test src/test/services/approval.service.test.ts",
        "test:phase2:wave1": "bun test src/test/lib/effect.runtime.test.ts src/test/lib/react-admin.test.ts src/test/services/notifications.service.test.ts src/test/routes/all-routes.registry.test.ts",
        "test:phase2:wave2": "bun test src/test/services/users.service.test.ts src/test/services/rbac.service.test.ts src/test/services/notifications.service.test.ts src/test/routes/all-routes.registry.test.ts",
        "test:phase2:wave3": "pnpm test:phase2:wave2 && pnpm test:users-route-contract && pnpm test:auth-route-contract && pnpm test:notifications-route-contract && pnpm test:approval-route-contract && pnpm test:jobs-route-contract && pnpm test:ifrs9-route-contract && pnpm test:approval-service && pnpm test:approval",
        "test:phase2:baseline": "bun test --coverage src/test/lib/effect.runtime.test.ts src/test/lib/react-admin.test.ts src/test/services/notifications.service.test.ts src/test/routes/all-routes.registry.test.ts src/test/routes/product-parameters.schema.test.ts src/test/routes/business-settings.schema.test.ts",
        "test:phase2:baseline:wave2": "bun test --coverage src/test/lib/effect.runtime.test.ts src/test/lib/react-admin.test.ts src/test/services/notifications.service.test.ts src/test/services/users.service.test.ts src/test/services/rbac.service.test.ts src/test/routes/all-routes.registry.test.ts src/test/routes/product-parameters.schema.test.ts src/test/routes/business-settings.schema.test.ts",
        "test:phase2:baseline:wave3": "pnpm test:phase2:baseline:wave2 && bun test --coverage src/test/routes/users.response-contract.test.ts && bun test --coverage src/test/routes/auth.response-contract.test.ts && bun test --coverage src/test/routes/notifications.response-contract.test.ts && bun test --coverage src/test/routes/approval.response-contract.test.ts && bun test --coverage src/test/routes/jobs.response-contract.test.ts && bun test --coverage src/test/routes/ifrs9.response-contract.test.ts && bun test --coverage src/test/services/approval.service.test.ts && bun test --coverage src/test/lib/approval-helpers.test.ts src/test/services/permission-approval.service.test.ts",
        "test:coverage:api": "bun test --coverage src/test/services/notifications.service.test.ts src/test/lib/effect.runtime.test.ts",
        "test:coverage:routes": "bun test --coverage src/test/routes src/test/services/notifications.service.test.ts src/test/lib/effect.runtime.test.ts",
        "test:watch": "bun test --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed": "bun run src/db/seed.ts",
        "docs": "typedoc",
        "docs:serve": "npx serve docs",
        "ops": "bun run src/cli.ts"
    },
    "dependencies": {
        "@hono/zod-openapi": "0.18.3",
        "@hono/zod-validator": "^0.4.1",
        "@scalar/hono-api-reference": "^0.9.30",
        "@socket.io/bun-engine": "^0.1.0",
        "bullmq": "^5.66.7",
        "commander": "^14.0.3",
        "drizzle-orm": "0.38.2",
        "effect": "^3.12.5",
        "hono": "^4.6.16",
        "ioredis": "^5.9.2",
        "jose": "^6.1.3",
        "nanoid": "^5.1.6",
        "pg": "^8.18.0",
        "pino": "^9.14.0",
        "pino-pretty": "^11.3.0",
        "postgres": "^3.4.5",
        "smtp": "^0.1.4",
        "socket.io": "^4.8.3",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@types/bun": "^1.1.14",
        "drizzle-kit": "0.30.1",
        "typedoc": "^0.28.16",
        "typedoc-plugin-markdown": "^4.9.0",
        "typescript": "^5.7.2"
    },
    "engines": {
        "bun": ">=1.0.0"
    },
    "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
