  /**
   * FIXED: Health check for FRS9 database connection
   */
  async healthCheck(req: AuthenticatedRequest, res: Response): Promise<void> {
    const client = await frs9Pool.connect();

    try {
      // Test basic connectivity
      await client.query('SELECT NOW() as server_time, version() as postgres_version');

      // Test table access
      const tableCheck = await client.query(`
        SELECT EXISTS (
          SELECT FROM information_schema.tables
          WHERE table_schema = 'public'
          AND table_name = 'frs9_param_commonh'
        ) as table_exists
      `);

      const tableExists = tableCheck.rows[0].table_exists;

      if (tableExists) {
        const countCheck = await client.query(`
          SELECT COUNT(*) as total_params FROM frs9_param_commonh
        `);
        const totalParams = parseInt(countCheck.rows[0].total_params);

        res.json({
          success: true,
          data: {
            service: 'FRS9 Parameter Service',
            status: 'healthy',
            database: {
              connection: 'healthy',
              host: '192.168.0.106:5433',
              database: 'FRS9PRO',
              port: 5433
            },
            table: {
              name: 'frs9_param_commonh',
              exists: true,
              total_params: totalParams
            },
            features: {
              application_setup: true,
              business_setup: true,
              direct_connection: true
            }
          },
          message: 'FRS9 Parameter service is healthy with direct PostgreSQL connection',
          timestamp: new Date().toISOString()
        });
      } else {
        res.status(503).json({
          success: false,
          data: {
            service: 'FRS9 Parameter Service',
            status: 'degraded',
            database: {
              connection: 'healthy',
              host: '192.168.0.106:5433',
              database: 'FRS9PRO'
            },
            table: {
              name: 'frs9_param_commonh',
              exists: false
            },
            features: {
              application_setup: false,
              business_setup: false
            }
          },
          message: 'FRS9 database connected but table not found',
          code: 'TABLE_MISSING',
          timestamp: new Date().toISOString()
        });
      }

    } catch (error) {
      console.error('FRS9 Parameter Service Health Check Error:', error);

      res.status(503).json({
        success: false,
        data: {
          service: 'FRS9 Parameter Service',
          status: 'unhealthy',
          database: {
            connection: 'failed',
            host: '192.168.0.106:5433',
            database: 'FRS9PRO'
          },
          features: {
            application_setup: false,
            business_setup: false
          }
        },
        error: 'FRS9 database connection failed',
        details: error instanceof Error ? error.message : 'Unknown error',
        code: 'DATABASE_CONNECTION_FAILED',
        timestamp: new Date().toISOString()
      });
    } finally {
      client.release();
    }
  }
}

// Export controller methods using instance to avoid static method issues
const frs9FixedInstance = new FRS9ParameterFixedController();

export const getApplicationSetupFixed = frs9FixedInstance.getApplicationSetup.bind(frs9FixedInstance);
export const getBusinessSetupFixed = frs9FixedInstance.getBusinessSetup.bind(frs9FixedInstance);
export const createApplicationSetupFixed = frs9FixedInstance.createApplicationSetup.bind(frs9FixedInstance);
export const updateApplicationSetupFixed = frs9FixedInstance.updateApplicationSetup.bind(frs9FixedInstance);
export const deleteApplicationSetupFixed = frs9FixedInstance.deleteApplicationSetup.bind(frs9FixedInstance);
export const createBusinessSetupFixed = frs9FixedInstance.createBusinessSetup.bind(frs9FixedInstance);
export const updateBusinessSetupFixed = frs9FixedInstance.updateBusinessSetup.bind(frs9FixedInstance);
export const deleteBusinessSetupFixed = frs9FixedInstance.deleteBusinessSetup.bind(frs9FixedInstance);
export const frs9ParameterHealthCheck = frs9FixedInstance.healthCheck.bind(frs9FixedInstance);