// packages/backend/src/api/controllers/frs9-parameter-fixed.controller.ts
// ============================================================================
// 🚨 FIXED VERSION: Robust FRS9 Parameter Controller with Direct DB Connection
// ============================================================================
// Purpose: Fixed controller that uses direct PostgreSQL connections
// to avoid Sequelize crashes when accessing FRS9 database
// Database: FRS9PRO (192.168.0.106:5433) - Direct connection
// Tables: frs9_param_commonh, frs9_param_commond, frs9_param_product, frs9_param_journal
// ============================================================================

import { Request, Response } from 'express';
import { Pool } from 'pg';

// Direct PostgreSQL connection to FRS9 database
const frs9Pool = new Pool({
  host: '192.168.0.106',
  port: 5433,
  database: 'FRS9PRO',
  user: 'postgres',
  password: 'postgres',
  ssl: false,
  max: 10,
  idleTimeoutMillis: 30000,
  connectionTimeoutMillis: 10000,
});

// Auth context interface - compatible with existing auth middleware
interface AuthenticatedRequest extends Request {
  user?: {
    userId?: string;
    email?: string;
    tenantId?: string;
    roles?: string[];
  };
}

// Helper function to get audit context
const getAuditContext = (req: AuthenticatedRequest) => {
  const userContext = req.user || { userId: 'SYSTEM', email: 'system@ifrs9.local' };
  return {
    createdby: userContext.email || 'SYSTEM',
    createdhost: req.ip || req.connection?.remoteAddress || 'localhost',
  };
};

export class FRS9ParameterFixedController {

  /**
   * FIXED: Get application setup parameters using master-detail relationship
   * Matches legacy Application Setting function exactly
   */
  async getApplicationSetup(req: AuthenticatedRequest, res: Response): Promise<void> {
    const client = await frs9Pool.connect();

    try {
      console.log('📋 [APPLICATION SETUP] Getting application parameters with master-detail relationship');

      // Master-detail query to get headers with their detail records
      const masterQuery = `
        SELECT
          h.pkid as header_pkid,
          h.param_code,
          h.param_name,
          h.param_usage,
          h.param_type,
          h.createdby as header_createdby,
          h.createddate as header_createddate,
          h.createdhost as header_createdhost,
          h.updatedby as header_updatedby,
          h.updateddate as header_updateddate,
          h.updatedhost as header_updatedhost,
          -- Aggregate detail information for display
          COUNT(d.pkid) as detail_count,
          STRING_AGG(d.value1 || ': ' || d.paramdesc, '; ' ORDER BY d.param_seq) as aggregated_values
        FROM frs9_param_commonh h
        LEFT JOIN frs9_param_commond d ON h.param_code = d.param_code
        WHERE h.param_type = 'S'
        GROUP BY h.pkid, h.param_code, h.param_name, h.param_usage, h.param_type,
                 h.createdby, h.createddate, h.createdhost,
                 h.updatedby, h.updateddate, h.updatedhost
        ORDER BY h.param_code ASC
      `;

      const masterResult = await client.query(masterQuery);
      console.log(`✅ [APPLICATION SETUP] Found ${masterResult.rows.length} application headers`);

      // Transform data to match legacy DataTables format exactly
      const transformedData = masterResult.rows.map(row => ({
        ID: row.header_pkid,
        CommonCode: row.param_code,
        Description: row.param_name,
        Value: row.aggregated_values || 'No details configured', // Computed value from details
        // Legacy compatibility fields - include additional info but not primary
        ParamType: row.param_type,
        ParamUsage: row.param_usage,
        DetailCount: parseInt(row.detail_count),
        // Additional fields for frontend functionality
        param_category: 'Application',
        is_editable: true,
        active_flag: true,
        created_by: row.header_createdby,
        created_date: row.header_createddate,
        updated_by: row.header_updatedby,
        updated_date: row.header_updateddate
      }));

      console.log('✅ [APPLICATION SETUP] Master data transformed successfully:', transformedData.length, 'parameters');

      res.status(200).json({
        success: true,
        data: transformedData,
        total: transformedData.length,
        message: `Successfully retrieved ${transformedData.length} application parameters`,
        database_info: {
          host: '192.168.0.106:5433',
          database: 'FRS9PRO',
          table: 'frs9_param_commonh',
          connection: 'direct_postgresql',
          environment: 'development'
        }
      });

    } catch (error) {
      console.error('❌ [FIXED] Get application setup error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to get application setup parameters',
        code: 'GET_APPLICATION_SETUP_ERROR',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    } finally {
      client.release();
    }
  }

  /**
   * FIXED: Get application setup detail records for a specific parameter code
   * Matches legacy LoadDataDetail function exactly
   */
  async getApplicationSetupDetails(req: AuthenticatedRequest, res: Response): Promise<void> {
    const client = await frs9Pool.connect();

    try {
      const { paramCode } = req.params;
      console.log(`📋 [APPLICATION SETUP DETAIL] Getting details for parameter code: ${paramCode}`);

      if (!paramCode) {
        return res.status(400).json({
          success: false,
          error: 'Parameter code is required',
          code: 'MISSING_PARAM_CODE'
        });
      }

      // Query to get detail records for the specific parameter code
      const detailQuery = `
        SELECT
          d.pkid,
          d.param_code,
          d.param_seq,
          d.value1,
          d.value2,
          d.value3,
          d.paramdesc,
          d.createdby,
          d.createddate,
          d.createdhost,
          d.updatedby,
          d.updateddate,
          d.updatedhost
        FROM frs9_param_commond d
        WHERE d.param_code = $1
        ORDER BY d.param_seq ASC
      `;

      const result = await client.query(detailQuery, [paramCode]);
      console.log(`✅ [APPLICATION SETUP DETAIL] Found ${result.rows.length} detail records for ${paramCode}`);

      // Transform data to match legacy DataTables format exactly
      const transformedData = result.rows.map(row => ({
        ID: row.pkid,
        CommonCode: row.param_code,
        SeqNo: row.param_seq,
        Value1: row.value1,
        Value2: row.value2,
        Value3: row.value3,
        Description: row.paramdesc,
        ParamDesc: row.paramdesc, // Alternative field name
        created_by: row.createdby,
        created_date: row.createddate,
        updated_by: row.updatedby,
        updated_date: row.updateddate
      }));

      console.log('✅ [APPLICATION SETUP DETAIL] Detail data transformed successfully:', transformedData.length, 'records');

      res.status(200).json({
        success: true,
        data: transformedData,
        total: transformedData.length,
        message: `Successfully retrieved ${transformedData.length} detail records for ${paramCode}`,
        param_code: paramCode,
        database_info: {
          host: '192.168.0.106:5433',
          database: 'FRS9PRO',
          table: 'frs9_param_commond',
          connection: 'direct_postgresql'
        }
      });

    } catch (error) {
      console.error('❌ [APPLICATION SETUP DETAIL] Get details error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to get application setup details',
        code: 'GET_APPLICATION_SETUP_DETAILS_ERROR',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    } finally {
      client.release();
    }
  }

  /**
   * FIXED: Get business setup parameters using direct PostgreSQL connection
   */
  async getBusinessSetup(req: AuthenticatedRequest, res: Response): Promise<void> {
    const client = await frs9Pool.connect();

    try {
      console.log('🏢 [FIXED] Getting business setup parameters using direct PostgreSQL connection');

      // Direct SQL query with details join
      const query = `
        SELECT
          h.pkid,
          h.param_code,
          h.param_name,
          h.param_usage,
          h.param_type,
          h.createdby,
          h.createddate,
          h.createdhost,
          h.updatedby,
          h.updateddate,
          h.updatedhost
        FROM frs9_param_commonh h
        WHERE h.param_type = 'B'
        ORDER BY h.param_code ASC
      `;

      const result = await client.query(query);
      console.log(`✅ [FIXED] Found ${result.rows.length} business parameters from frs9_param_commonh`);

      // Transform data to match expected frontend format
      const transformedData = result.rows.map(row => ({
        pkid: row.pkid,
        param_code: row.param_code,
        param_name: row.param_name,
        param_usage: row.param_usage,
        param_type: row.param_type,
        param_desc: row.param_usage, // Use param_usage as description
        param_category: 'Business',
        param_value: '', // Empty value for header records
        is_editable: true,
        active_flag: true,
        created_by: row.createdby,
        created_date: row.createddate
      }));

      console.log('✅ [FIXED] Business setup transformed successfully:', transformedData.length, 'parameters');

      res.status(200).json({
        success: true,
        data: transformedData,
        total: transformedData.length,
        message: `Successfully retrieved ${transformedData.length} business parameters`,
        database_info: {
          host: '192.168.0.106:5433',
          database: 'FRS9PRO',
          table: 'frs9_param_commonh',
          connection: 'direct_postgresql',
          environment: 'development'
        }
      });

    } catch (error) {
      console.error('❌ [FIXED] Get business setup error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to get business setup parameters',
        code: 'GET_BUSINESS_SETUP_ERROR',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    } finally {
      client.release();
    }
  }

