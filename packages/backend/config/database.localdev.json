{
  "$schema": "./database-schema.json",
  "version": "1.0.0",
  "lastUpdated": "2025-11-02T20:00:00.000Z",
  "updatedBy": "system",
  "environment": "localdev",

  "servers": [
    {
      "id": "DS1_LOCAL",
      "name": "Primary Database Server - Local Development",
      "description": "Local PostgreSQL server for platform and tenant databases",
      "host": "localhost",
      "port": 5432,
      "type": "primary",
      "region": "local",
      "isActive": true,
      "credentials": {
        "username": "postgres",
        "password": "postgres"
      },
      "ssl": false,
      "maxConnections": 20,
      "connectionPool": {
        "min": 5,
        "max": 20,
        "idleTimeoutMillis": 30000,
        "connectionTimeoutMillis": 10000,
        "acquireTimeoutMillis": 10000
      },
      "monitoring": {
        "healthCheckInterval": 30000,
        "alertThresholds": {
          "responseTime": 1000,
          "errorRate": 0.05,
          "connectionUtilization": 0.8
        }
      },
      "tags": ["primary", "local", "platform", "development"]
    },

    {
      "id": "DS2_LOCAL",
      "name": "FRS9 Analytics Server - Local Development",
      "description": "Local PostgreSQL server for FRS9 legacy data and analytics",
      "host": "192.168.0.106",
      "port": 5433,
      "type": "analytics",
      "region": "local",
      "isActive": true,
      "credentials": {
        "username": "postgres",
        "password": "postgres"
      },
      "ssl": false,
      "maxConnections": 10,
      "connectionPool": {
        "min": 2,
        "max": 10,
        "idleTimeoutMillis": 30000,
        "connectionTimeoutMillis": 10000,
        "acquireTimeoutMillis": 10000
      },
      "monitoring": {
        "healthCheckInterval": 45000,
        "alertThresholds": {
          "responseTime": 2000,
          "errorRate": 0.1
        }
      },
      "tags": ["analytics", "legacy", "frs9", "development"]
    }
  ],

  "databases": [
    {
      "id": "platform_admin",
      "name": "Platform Administration",
      "description": "Core platform administration and user management database",
      "serverId": "DS1_LOCAL",
      "database": "ifrspro_platform_admin",
      "type": "platform",
      "tags": ["core", "admin", "user-management", "critical"],
      "priority": 1,
      "isActive": true,
      "maxConnections": 20,
      "schema": {
        "searchPath": ["platform_admin", "platform_audit", "platform_analytics", "platform_billing", "public"],
        "defaultSchema": "platform_admin"
      },
      "features": {
        "auditing": true,
        "softDelete": false,
        "versioning": true,
        "encryption": false
      },
      "compliance": {
        "dataRetention": "7y",
        "auditLevel": "high",
        "regulations": ["GDPR", "SOX"]
      }
    },

    {
      "id": "shared_services",
      "name": "Shared Services",
      "description": "Shared reference data and calculation engines",
      "serverId": "DS1_LOCAL",
      "database": "ifrspro_shared_services",
      "type": "shared",
      "tags": ["shared", "reference-data", "calculations", "menu"],
      "priority": 2,
      "isActive": true,
      "maxConnections": 15,
      "schema": {
        "searchPath": ["reference_data", "calculation_engine", "menu", "notification", "public"],
        "defaultSchema": "reference_data"
      },
      "features": {
        "caching": true,
        "readReplica": false,
        "partitioning": false
      }
    },

    {
      "id": "frs9_legacy",
      "name": "FRS9 Legacy System",
      "description": "Legacy FRS9 parameter and calculation database",
      "serverId": "DS2_LOCAL",
      "database": "FRS9PRO",
      "type": "legacy",
      "tags": ["legacy", "parameters", "calculations", "frs9"],
      "priority": 3,
      "isActive": true,
      "maxConnections": 5,
      "schema": {
        "searchPath": ["public"],
        "defaultSchema": "public"
      },
      "features": {
        "readOnly": false,
        "migration": {
          "planned": true,
          "targetDatabase": "shared_services",
          "schedule": "2025-Q2"
        }
      },
      "compliance": {
        "dataRetention": "5y",
        "regulations": ["OJK", "BI"]
      }
    },

    {
      "id": "ifrs9_analytics",
      "name": "IFRS9 Analytics Database",
      "description": "IFRS9 calculations and R analytics processing",
      "serverId": "DS2_LOCAL",
      "database": "IFRS9_pro",
      "type": "analytics",
      "tags": ["analytics", "r-processing", "calculations", "ifrs9"],
      "priority": 4,
      "isActive": true,
      "maxConnections": 8,
      "features": {
        "bulkOperations": true,
        "parallelProcessing": true
      }
    },

    {
      "id": "tenant_iaf",
      "name": "IAF - Indonesia Airawata Finance",
      "description": "Indonesia Airawata Finance conventional banking tenant",
      "serverId": "DS1_LOCAL",
      "database": "ifrspro_tenant_iaf",
      "type": "tenant",
      "tags": ["tenant", "conventional", "iaf", "production"],
      "priority": 8,
      "isActive": true,
      "maxConnections": 15,
      "schema": {
        "searchPath": ["core", "calculation", "staging", "audit", "workflow", "configuration", "external_integration", "data_quality", "public"],
        "defaultSchema": "core"
      },
      "tenantInfo": {
        "tenantSlug": "iaf",
        "organizationName": "Indonesia Airawata Finance",
        "bankingType": "conventional",
        "subscriptionTier": "enterprise",
        "region": "indonesia",
        "regulatoryFramework": "OJK"
      },
      "features": {
        "auditing": true,
        "softDelete": true,
        "encryption": true,
        "backup": {
          "frequency": "daily",
          "retention": "30d"
        }
      },
      "compliance": {
        "dataResidency": "indonesia",
        "regulations": ["OJK", "BI"],
        "auditLevel": "high"
      }
    }
  ],

  "settings": {
    "autoDiscovery": true,
    "healthCheckInterval": 30000,
    "connectionTimeout": 10000,
    "maxHistorySize": 100,
    "configReloadInterval": 300000,

    "failover": {
      "enabled": true,
      "maxRetries": 3,
      "retryDelayMs": 1000,
      "backoffMultiplier": 2.0,
      "maxRetryDelayMs": 30000
    },

    "loadBalancing": {
      "strategy": "round-robin",
      "healthyThreshold": 0.95,
      "weights": {
        "DS1_LOCAL": 1.0,
        "DS2_LOCAL": 0.5
      }
    },

    "security": {
      "encryptCredentials": false,
      "rotatePasswords": false,
      "auditConnections": false,
      "maxLoginAttempts": 5,
      "lockoutDurationMs": 300000
    },

    "monitoring": {
      "enabled": true,
      "metricsCollection": true,
      "performanceLogging": true,
      "slowQueryThresholdMs": 1000,
      "alerting": {
        "enabled": false,
        "channels": ["console"],
        "escalation": {
          "criticalDelayMs": 300000,
          "majorDelayMs": 900000
        }
      }
    },

    "caching": {
      "enabled": true,
      "provider": "redis",
      "ttl": 300000,
      "maxSize": "100MB"
    }
  },

  "environments": {
    "development": {
      "description": "Development environment overrides",
      "overrides": {
        "healthCheckInterval": 60000,
        "maxConnections": 5,
        "logging": {
          "level": "debug",
          "queries": true
        },
        "security": {
          "encryptCredentials": false,
          "auditConnections": false
        }
      }
    }
  },

  "validation": {
    "rules": [
      {
        "rule": "unique_server_ids",
        "description": "All server IDs must be unique"
      },
      {
        "rule": "unique_database_ids",
        "description": "All database IDs must be unique"
      },
      {
        "rule": "valid_server_references",
        "description": "All database serverId references must point to existing servers"
      },
      {
        "rule": "priority_range",
        "description": "Database priorities must be between 1 and 100"
      }
    ]
  }
}