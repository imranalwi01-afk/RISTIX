  "settings": {
    "autoDiscovery": true,
    "healthCheckInterval": 30000,
    "connectionTimeout": 10000,
    "maxHistorySize": 100,
    "configReloadInterval": 300000,
    
    "failover": {
      "enabled": true,
      "maxRetries": 3,
      "retryDelayMs": 1000,
      "backoffMultiplier": 2.0,
      "maxRetryDelayMs": 30000
    },
    
    "loadBalancing": {
      "strategy": "round-robin",
      "healthyThreshold": 0.95,
      "weights": {
        "DS1": 1.0,
        "DS2": 0.5,
        "DS3_PROD": 2.0
      }
    },
    
    "security": {
      "encryptCredentials": true,
      "rotatePasswords": false,
      "auditConnections": true,
      "maxLoginAttempts": 5,
      "lockoutDurationMs": 300000
    },
    
    "monitoring": {
      "enabled": true,
      "metricsCollection": true,
      "performanceLogging": true,
      "slowQueryThresholdMs": 1000,
      "alerting": {
        "enabled": true,
        "channels": ["email", "slack", "webhook"],
        "escalation": {
          "criticalDelayMs": 300000,
          "majorDelayMs": 900000
        }
      }
    },
    
    "caching": {
      "enabled": true,
      "provider": "redis",
      "ttl": 300000,
      "maxSize": "100MB"
    },
    
    "backup": {
      "globalSettings": {
        "compression": true,
        "encryption": true,
        "retentionPolicy": "30d",
        "schedule": "0 2 * * *"
      }
    }
  },
  
  "environments": {
    "development": {
      "description": "Development environment overrides",
      "overrides": {
        "healthCheckInterval": 60000,
        "maxConnections": 5,
        "logging": {
          "level": "debug",
          "queries": true
        },
        "security": {
          "encryptCredentials": false,
          "auditConnections": false
        }
      }
    },
    
    "staging": {
      "description": "Staging environment overrides",
      "overrides": {
        "ssl": false,
        "healthCheckInterval": 15000,
        "maxConnections": 10,
        "monitoring": {
          "alerting": {
            "enabled": false
          }
        }
      }
    },
    
    "production": {
      "description": "Production environment overrides",
      "overrides": {
        "ssl": false,
        "healthCheckInterval": 10000,
        "security": {
          "encryptCredentials": true,
          "auditConnections": true
        },
        "monitoring": {
          "alerting": {
            "enabled": true,
            "channels": ["email", "slack", "webhook", "pagerduty"]
          }
        },
        "backup": {
          "frequency": "hourly",
          "retention": "90d"
        }
      }
    }
  },
  
