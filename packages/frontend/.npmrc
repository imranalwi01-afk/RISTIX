# pnpm configuration for better performance
# ============================================================================

# Faster installs
prefer-frozen-lockfile=true
auto-install-peers=true

# Better caching
store-dir=~/.pnpm-store
package-import-method=hardlink

# Strict mode (disabled for compatibility)
strict-peer-dependencies=false

# Performance optimizations
side-effects-cache=true
side-effects-cache-readonly=false

# Hoisting configuration
shamefully-hoist=true
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*

# Use default linker for better compatibility with standalone tracer
# node-linker=isolated

# Network settings
network-concurrency=16
fetch-retries=3
fetch-retry-factor=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Resolution settings
resolution-mode=highest
