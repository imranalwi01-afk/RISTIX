{
  "name": "@ifrs9/frontend",
  "version": "1.0.0",
  "description": "IFRS 9 Platform Frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' WSS_PORT=4231 next dev --turbopack -p 4231 -H 0.0.0.0",
    "dev:webpack": "NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' WSS_PORT=4231 next dev -p 4231 -H 0.0.0.0",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start -p 4231 -H 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test:access-management": "bun test src/components/maintenance/access-management.utils.test.ts",
    "test:collective-validation": "bun test src/lib/validation/collective-config.validation.test.ts",
    "test:users-api-utils": "bun test src/services/users-api.utils.test.ts",
    "test:roles-api-utils": "bun test src/services/roles-api.utils.test.ts",
    "clean": "bun ops clean",
    "clean-all": "bun ops clean --all",
    "analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' next build",
    "docs": "typedoc",
    "docs:serve": "npx serve ../docs/docs/frontend-api",
    "ops": "bun run src/cli.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.9.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "7.0.1-beta.21",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "@mui/x-data-grid": "^8.25.0",
    "@mui/x-date-pickers": "^8.25.0",
    "@reduxjs/toolkit": "^2.2.8",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "core-js": "3",
    "critters": "^0.0.16",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.456.0",
    "next": "16.1.3",
    "notistack": "^3.0.2",
    "process": "^0.11.10",
    "query-string": "^9.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.53.0",
    "react-redux": "^9.1.2",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "styled-jsx": "5.1.6",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.1.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.8",
      "@types/react-dom": "19.2.3"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
