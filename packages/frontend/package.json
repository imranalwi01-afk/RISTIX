    "query-string": "^9.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.1.2",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "styled-jsx": "5.1.6",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1",
    "zod": "^3.23.8"
