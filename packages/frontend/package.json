    "@reduxjs/toolkit": "^2.2.8",
    "@tanstack/react-query": "^5.99.2",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "core-js": "3",
    "critters": "^0.0.16",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
