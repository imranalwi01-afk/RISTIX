{
  "name": "@ifrs9/frontend",
  "version": "1.0.0",
  "description": "IFRS 9 Platform Frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "node -e \"process.env.NEXT_TELEMETRY_DISABLED='1';process.env.NODE_OPTIONS='--max-old-space-size=4096';process.env.WSS_PORT='4231';process.env.NEXT_PUBLIC_BACKEND_URL ||= 'http://localhost:4232';process.env.NEXT_PUBLIC_BACKEND_API_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_API_BASE_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_WS_URL ||= 'http://localhost:4232';const nextBin=require.resolve('next/dist/bin/next');const{spawn}=require('child_process');const c=spawn(process.execPath,[nextBin,'dev','--webpack','-p','4231','-H','0.0.0.0'],{stdio:'inherit',env:process.env});c.on('exit',code=>process.exit(code??0));\"",
    "dev:turbopack": "node -e \"process.env.NEXT_TELEMETRY_DISABLED='1';process.env.NODE_OPTIONS='--max-old-space-size=4096';process.env.WSS_PORT='4231';process.env.NEXT_PUBLIC_BACKEND_URL ||= 'http://localhost:4232';process.env.NEXT_PUBLIC_BACKEND_API_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_API_BASE_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_WS_URL ||= 'http://localhost:4232';const nextBin=require.resolve('next/dist/bin/next');const{spawn}=require('child_process');const c=spawn(process.execPath,[nextBin,'dev','--turbopack','-p','4231','-H','0.0.0.0'],{stdio:'inherit',env:process.env});c.on('exit',code=>process.exit(code??0));\"",
    "dev:webpack": "node -e \"process.env.NEXT_TELEMETRY_DISABLED='1';process.env.NODE_OPTIONS='--max-old-space-size=4096';process.env.WSS_PORT='4231';process.env.NEXT_PUBLIC_BACKEND_URL ||= 'http://localhost:4232';process.env.NEXT_PUBLIC_BACKEND_API_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_API_BASE_URL ||= 'http://localhost:4232/api';process.env.NEXT_PUBLIC_WS_URL ||= 'http://localhost:4232';const nextBin=require.resolve('next/dist/bin/next');const{spawn}=require('child_process');const c=spawn(process.execPath,[nextBin,'dev','--webpack','-p','4231','-H','0.0.0.0'],{stdio:'inherit',env:process.env});c.on('exit',code=>process.exit(code??0));\"",
    "build": "node -e \"process.env.NODE_OPTIONS='--max-old-space-size=4096';const nextBin=require.resolve('next/dist/bin/next');const{spawn}=require('child_process');const c=spawn(process.execPath,[nextBin,'build'],{stdio:'inherit',env:process.env});c.on('exit',code=>process.exit(code??0));\"",
    "start": "next start -p 4231 -H 0.0.0.0",
    "lint": "eslint . --max-warnings 2000",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:access-management": "bun test src/components/maintenance/access-management.utils.test.ts",
    "test:collective-validation": "bun test src/lib/validation/collective-config.validation.test.ts",
    "test:users-api-utils": "bun test src/services/users-api.utils.test.ts",
    "test:roles-api-utils": "bun test src/services/roles-api.utils.test.ts",
    "clean": "bun ops clean",
    "clean-all": "bun ops clean --all",
    "analyze": "node -e \"process.env.ANALYZE='true';process.env.NODE_OPTIONS='--max-old-space-size=4096';const nextBin=require.resolve('next/dist/bin/next');const{spawn}=require('child_process');const c=spawn(process.execPath,[nextBin,'build'],{stdio:'inherit',env:process.env});c.on('exit',code=>process.exit(code??0));\"",
    "docs": "typedoc",
    "docs:serve": "npx serve ../docs/docs/frontend-api",
    "ops": "bun run src/cli.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "7.0.1-beta.21",
