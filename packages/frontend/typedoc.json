{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "expand",
    "entryPoints": [
        "src/hooks/useApi.ts",
        "src/hooks/useApiClient.ts",
        "src/hooks/useApprovalStatus.ts",
        "src/hooks/useBackendHealth.ts",
        "src/hooks/useLoginPrefetch.ts",
        "src/hooks/useMenuState.ts",
        "src/hooks/useNotificationSocket.ts",
        "src/hooks/usePermission.ts",
        "src/hooks/useSavedFilters.ts",
        "src/utils/api/index.ts",
        "src/utils/approval.ts",
        "src/utils/asyncExportUtils.ts",
        "src/utils/auth-debug.ts",
        "src/utils/auth-token.ts",
        "src/utils/banking/index.ts",
        "src/utils/constants.ts",
        "src/utils/cookie-domain.ts",
        "src/utils/date/index.ts",
        "src/utils/error-message.ts",
        "src/utils/export-csv.ts",
        "src/utils/exportUtils.ts",
        "src/utils/ifrs9/index.ts",
        "src/utils/loginRedirect.ts",
        "src/utils/menu-hierarchy.ts",
        "src/utils/menu-transform.ts",
        "src/utils/notification-utils.ts",
        "src/utils/permission-evaluator.ts",
        "src/utils/permissions.ts",
        "src/services/api/notification.api.ts",
        "src/services/menu.service.ts"
    ],
    "out": "../docs/docs/frontend-api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "hideBreadcrumbs": true,
    "readme": "none",
    "entryFileName": "index",
    "outputFileStrategy": "modules",
    "flattenOutputFiles": true,
    "membersWithOwnFile": [],
    "indexFormat": "table",
    "cleanOutputDir": true,
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*Diagnostic*.ts",
        "**/*DebugFix*.ts",
        "**/quick-auth-fix.js"
    ],
    "githubPages": false,
    "name": "Frontend API Reference",
    "includeVersion": true
}
