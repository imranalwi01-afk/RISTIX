// packages/frontend/src/app/banking/layout.tsx
// ============================================================================
// IFRS9 ENHANCED BANKING LAYOUT WITH COMPREHENSIVE SIDEBAR
// ============================================================================
// ✅ ENHANCED: Professional sidebar with IFRS9 business logic
// ✅ FIXED: All hrefs use DIRECT FOLDER structure (/banking/*)
// ✅ NEW: Role-based menus, banking mode support, status indicators
// ============================================================================

'use client';

import React, { useState, useEffect } from 'react';
import { usePathname } from 'next/navigation';
import {
  Box,
  Drawer,
  AppBar,
  Toolbar,
  Typography,
  IconButton,
  Avatar,
  Menu,
  MenuItem,
  Chip,
  Badge,
  Tooltip,
  Button,
  alpha,
  useTheme,
  useMediaQuery
} from '@mui/material';
import {
  Menu as MenuIcon,
  AccountCircle,
  Notifications,
  Settings,
  ExitToApp,
  Brightness4,
  Brightness7,
  SwapHoriz,
  Business,
  Security,
  Mosque,
  AccountBalance
} from '@mui/icons-material';

// Import our comprehensive sidebar
import BankingSidebar from '../../components/banking/BankingSidebar';

const DRAWER_WIDTH = 320; // Slightly wider for better readability

export default function BankingLayout({ children }: { children: React.ReactNode }) {
  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down('md'));
  const pathname = usePathname();
  
  // State management
  const [mobileOpen, setMobileOpen] = useState(false);
  const [anchorEl, setAnchorEl] = useState<null | HTMLElement>(null);
  const [notificationAnchor, setNotificationAnchor] = useState<null | HTMLElement>(null);
  const [bankingMode, setBankingMode] = useState<'conventional' | 'syariah' | 'dual'>('conventional');
  const [userRole, setUserRole] = useState<string>('');
  const [userName, setUserName] = useState<string>('');
  const [notifications, setNotifications] = useState(3);

  // Initialize user data
  useEffect(() => {
    if (typeof document !== 'undefined') {
      // Get user info from cookies or API
      const role = document.cookie
        .split('; ')
        .find(row => row.startsWith('auth-token='))
        ?.split('=')[1];
      
      if (role) {
        try {
          const userData = JSON.parse(atob(role));
          setUserRole(userData.role || '');
          setUserName(userData.email || 'User');
          
          // Determine banking mode from role
          if (userData.role?.includes('SYARIAH') || userData.role?.includes('DPS')) {
            setBankingMode('syariah');
          } else if (userData.role?.includes('DUAL')) {
            setBankingMode('dual');
          }
        } catch (error) {
          console.warn('Could not parse user token');
        }
      }
    }
  }, []);

  const handleDrawerToggle = () => setMobileOpen(!mobileOpen);
  const handleProfileMenuOpen = (event: React.MouseEvent<HTMLElement>) => setAnchorEl(event.currentTarget);
  const handleProfileMenuClose = () => setAnchorEl(null);
  const handleNotificationOpen = (event: React.MouseEvent<HTMLElement>) => setNotificationAnchor(event.currentTarget);
  const handleNotificationClose = () => setNotificationAnchor(null);

  const handleBankingModeSwitch = () => {
    const modes: ('conventional' | 'syariah' | 'dual')[] = ['conventional', 'syariah', 'dual'];
    const currentIndex = modes.indexOf(bankingMode);
    const nextMode = modes[(currentIndex + 1) % modes.length];
    setBankingMode(nextMode);
    handleProfileMenuClose();
  };

  const handleLogout = () => {
    handleProfileMenuClose();
    if (typeof document !== 'undefined') {
      // Clear all auth cookies
      document.cookie = 'auth-token=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT';
      document.cookie = 'ifrs9_auth_token=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT';
      document.cookie = 'ifrs9_user_role=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT';
      document.cookie = 'ifrs9_user_email=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT';
    }
    window.location.href = '/login';
  };

  const getBankingModeIcon = () => {
    switch (bankingMode) {
      case 'syariah': return <Mosque />;
      case 'dual': return <SwapHoriz />;
      default: return <AccountBalance />;
    }
  };

  const getBankingModeColor = () => {
    switch (bankingMode) {
      case 'syariah': return 'success';
      case 'dual': return 'warning';
      default: return 'primary';
    }
  };

  const getBankingModeLabel = () => {
    switch (bankingMode) {
      case 'syariah': return 'Islamic Banking';
      case 'dual': return 'Dual Banking';
      default: return 'Conventional Banking';
    }
  };

  // Enhanced App Bar
  const appBar = (
    <AppBar
      position="fixed"
      sx={{
        width: { md: `calc(100% - ${DRAWER_WIDTH}px)` },
        ml: { md: `${DRAWER_WIDTH}px` },
        background: `linear-gradient(135deg, ${
          bankingMode === 'syariah' 
            ? theme.palette.success.main 
            : theme.palette.primary.main
        } 0%, ${
          bankingMode === 'syariah' 
            ? theme.palette.success.dark 
            : theme.palette.primary.dark
        } 100%)`,
        boxShadow: theme.shadows[4]
      }}
    >
      <Toolbar sx={{ minHeight: { xs: 56, sm: 64 } }}>
        {/* Mobile menu button */}
        <IconButton
          color="inherit"
          aria-label="open drawer"
          edge="start"
          onClick={handleDrawerToggle}
          sx={{ mr: 2, display: { md: 'none' } }}
        >
          <MenuIcon />
        </IconButton>

        {/* Title and breadcrumb */}
        <Box sx={{ flexGrow: 1 }}>
          <Typography variant="h6" noWrap component="div" sx={{ fontWeight: 600 }}>
            IFRS 9 Banking Platform
          </Typography>
          <Typography variant="caption" sx={{ opacity: 0.8 }}>
            {pathname.split('/').slice(1).join(' › ').replace(/\b\w/g, l => l.toUpperCase())}
          </Typography>
        </Box>

        {/* Banking Mode Indicator */}
        <Chip
          icon={getBankingModeIcon()}
          label={getBankingModeLabel()}
          color={getBankingModeColor() as any}
          variant="outlined"
          sx={{
            mr: 2,
            backgroundColor: 'rgba(255,255,255,0.1)',
            color: 'white',
            borderColor: 'rgba(255,255,255,0.3)',
            '&:hover': {
              backgroundColor: 'rgba(255,255,255,0.2)',
            }
          }}
          onClick={handleBankingModeSwitch}
        />

        {/* Notifications */}
        <Tooltip title="Notifications">
          <IconButton
            size="large"
            color="inherit"
            onClick={handleNotificationOpen}
            sx={{ mr: 1 }}
          >
            <Badge badgeContent={notifications} color="error">
              <Notifications />
            </Badge>
          </IconButton>
        </Tooltip>

        {/* Settings */}
        <Tooltip title="Settings">
          <IconButton size="large" color="inherit" sx={{ mr: 1 }}>
            <Settings />
          </IconButton>
        </Tooltip>

        {/* User menu */}
        <Tooltip title="User menu">
          <IconButton
            size="large"
            edge="end"
            color="inherit"
            onClick={handleProfileMenuOpen}
          >
            <Avatar sx={{ width: 32, height: 32, bgcolor: 'rgba(255,255,255,0.2)' }}>
              {userName.charAt(0).toUpperCase()}
            </Avatar>
          </IconButton>
        </Tooltip>
      </Toolbar>
    </AppBar>
  );

  // Enhanced sidebar drawer
  const drawer = (
    <BankingSidebar
      width={DRAWER_WIDTH}
      bankingMode={bankingMode}
      userRole={userRole}
      onMenuClick={(menuId, href) => {
        console.log(`Menu clicked: ${menuId} → ${href}`);
        if (isMobile) {
          setMobileOpen(false);
        }
      }}
    />
  );

  return (
    <Box sx={{ display: 'flex', minHeight: '100vh' }}>
      {/* App Bar */}
      {appBar}

      {/* Navigation Drawer */}
      <Box
        component="nav"
        sx={{ width: { md: DRAWER_WIDTH }, flexShrink: { md: 0 } }}
      >
        {/* Mobile drawer */}
        <Drawer
          variant="temporary"
          open={mobileOpen}
          onClose={handleDrawerToggle}
          ModalProps={{ keepMounted: true }}
          sx={{
            display: { xs: 'block', md: 'none' },
            '& .MuiDrawer-paper': {
              boxSizing: 'border-box',
              width: DRAWER_WIDTH,
              borderRight: 'none'
            },
          }}
        >
          {drawer}
        </Drawer>

        {/* Desktop drawer */}
        <Drawer
          variant="permanent"
          sx={{
            display: { xs: 'none', md: 'block' },
            '& .MuiDrawer-paper': {
              boxSizing: 'border-box',
              width: DRAWER_WIDTH,
              borderRight: 'none'
            },
          }}
          open
        >
          {drawer}
        </Drawer>
      </Box>

      {/* User Profile Menu */}
      <Menu
        id="user-menu"
        anchorEl={anchorEl}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
        keepMounted
        transformOrigin={{ vertical: 'top', horizontal: 'right' }}
        open={Boolean(anchorEl)}
        onClose={handleProfileMenuClose}
        PaperProps={{
          sx: { width: 250, mt: 1 }
        }}
      >
        {/* User Info Header */}
        <Box sx={{ p: 2, bgcolor: 'background.default' }}>
          <Typography variant="subtitle2" sx={{ fontWeight: 600 }}>
            {userName}
          </Typography>
          <Typography variant="caption" color="text.secondary">
            {userRole.replace(/_/g, ' ')}
          </Typography>
          <Chip
            size="small"
            label={getBankingModeLabel()}
            color={getBankingModeColor() as any}
            sx={{ mt: 1 }}
          />
        </Box>

        <MenuItem onClick={handleProfileMenuClose}>
          <AccountCircle sx={{ mr: 2 }} />
          Profile Settings
        </MenuItem>

        <MenuItem onClick={handleBankingModeSwitch}>
          {getBankingModeIcon()}
          <Box sx={{ ml: 2 }}>
            Switch Banking Mode
          </Box>
        </MenuItem>

        <MenuItem onClick={handleProfileMenuClose}>
          <Settings sx={{ mr: 2 }} />
          Preferences
        </MenuItem>

        <MenuItem onClick={handleProfileMenuClose}>
          <Brightness4 sx={{ mr: 2 }} />
          Theme Settings
        </MenuItem>

        <MenuItem onClick={handleLogout} sx={{ color: 'error.main' }}>
          <ExitToApp sx={{ mr: 2 }} />
          Logout
        </MenuItem>
      </Menu>

      {/* Notifications Menu */}
      <Menu
        id="notifications-menu"
        anchorEl={notificationAnchor}
        open={Boolean(notificationAnchor)}
        onClose={handleNotificationClose}
        PaperProps={{
          sx: { width: 320, maxHeight: 400 }
        }}
      >
        <Box sx={{ p: 2, bgcolor: 'primary.main', color: 'white' }}>
          <Typography variant="h6">Notifications</Typography>
          <Typography variant="caption">
            {notifications} unread messages
          </Typography>
        </Box>
        
        <MenuItem onClick={handleNotificationClose}>
          <Box>
            <Typography variant="body2" sx={{ fontWeight: 600 }}>
              ECL Calculation Complete
            </Typography>
            <Typography variant="caption" color="text.secondary">
              Portfolio calculation finished successfully
            </Typography>
          </Box>
        </MenuItem>
        
        <MenuItem onClick={handleNotificationClose}>
          <Box>
            <Typography variant="body2" sx={{ fontWeight: 600 }}>
              New Approval Required
            </Typography>
            <Typography variant="caption" color="text.secondary">
              Individual assessment needs approval
            </Typography>
          </Box>
        </MenuItem>
        
        <MenuItem onClick={handleNotificationClose}>
          <Box>
            <Typography variant="body2" sx={{ fontWeight: 600 }}>
              Data Upload Ready
            </Typography>
            <Typography variant="caption" color="text.secondary">
              Monthly portfolio data available
            </Typography>
          </Box>
        </MenuItem>
      </Menu>

      {/* Main Content */}
      <Box
        component="main"
        sx={{
          flexGrow: 1,
          width: { md: `calc(100% - ${DRAWER_WIDTH}px)` },
          minHeight: '100vh',
          bgcolor: 'background.default'
        }}
      >
        {/* Toolbar spacer */}
        <Toolbar sx={{ minHeight: { xs: 56, sm: 64 } }} />
        
        {/* Page Content */}
        <Box sx={{ p: 3 }}>
          {children}
        </Box>
      </Box>
    </Box>
  );
}