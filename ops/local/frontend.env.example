# Frontend-only overrides for ops/local/docker-compose.yml
# Copy to ops/local/frontend.env and adjust values.

NODE_ENV=development

# Backend API/WS should point to local backend in localdev
NEXT_PUBLIC_BACKEND_URL=http://localhost:5232
NEXT_PUBLIC_API_BASE_URL=http://localhost:5232/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5232/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:5232

# R Analytics (local)
NEXT_PUBLIC_R_ANALYTICS_URL=http://localhost:4236
NEXT_PUBLIC_RAPI_BASE_URL=http://localhost:4241/api
