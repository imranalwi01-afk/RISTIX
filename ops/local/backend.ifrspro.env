# Backend-only overrides for ops/local/docker-compose.yml
# Generated by Trae to fix missing env file

# Local backend URL defaults
BACKEND_URL=http://localhost:4232
API_BASE_URL=http://localhost:4232/api
RAPI_BASE_URL=http://localhost:4241/api
CORS_ORIGINS=http://localhost:4231,http://127.0.0.1:4231,http://[::1]:4231

# Database Configuration (REMOTE VIA VPN)
DB_HOST=172.25.0.25
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Platform Database
PLATFORM_DB_HOST=172.25.0.25
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=ifrspro_platform_admin
PLATFORM_DB_SSL=false

# Shared Services Database
SHARED_DB_HOST=172.25.0.25
SHARED_DB_PORT=5432
SHARED_DB_USER=postgres
SHARED_DB_PASSWORD=postgres
SHARED_DB_NAME=ifrspro_shared_services
SHARED_DB_SSL=false

# Tenant Database
TENANT_DB_HOST=172.25.0.25
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_NAME=ifrspro_tenant_iaf
TENANT_DB_SSL=false

# Legacy FRS9 Database (DS2) - REMOTE
LEGACY_DB_HOST=172.25.0.25
LEGACY_DB_PORT=5432
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=postgres
LEGACY_DB_NAME=FRS9PRO
LEGACY_DB_SSL=false

# Server Configuration
BACKEND_PORT=4232
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_DIR=logs

# Discord alerting (optional)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_DISCORD_TIMEOUT_MS=5000
ALERT_MIN_LEVEL=error
ALERT_THROTTLE_MS=60000

# Security Configuration
JWT_SECRET=local-dev-secret-key-change-in-production-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=local-encryption-key-32-chars-len
SALT_ROUNDS=12

# Approval governance
APPROVAL_ALLOW_SUPERADMIN_SELF_APPROVAL=true
APPROVAL_ALLOW_SUPERADMIN_LEVEL_BYPASS=true
APPROVAL_ALLOW_SUPERADMIN_COUNT_BYPASS=true
APPROVAL_AUTO_APPROVE_SUPERADMIN_REQUESTS=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10
REDIS_TOKEN_BLACKLIST_DB=4
REDIS_SESSION_DB=11

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
