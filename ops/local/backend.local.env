# Local Docker database configuration.
# Use with:
#   $env:BACKEND_SERVICE_ENV_FILE='backend.local.env'
#   docker compose --env-file ops/local/.env -f ops/local/docker-compose.yml --profile dev --profile frontend up -d postgres redis db-init platform-init tenant-migrate tenant-seed new-backend frontend

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ifrspro_platform_admin

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ifrspro_platform_admin

PLATFORM_DB_HOST=postgres
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=ifrspro_platform_admin
PLATFORM_DB_SSL=false

TENANT_DB_HOST=postgres
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_NAME=ifrspro_tenant_iaf
TENANT_DB_SSL=false

LEGACY_DB_HOST=postgres
LEGACY_DB_PORT=5432
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=postgres
LEGACY_DB_NAME=FRS9PRO
LEGACY_DB_SSL=false
LEGACY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/FRS9PRO

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=8h

NODE_ENV=development
PORT=4232
HOST=0.0.0.0
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:4231
BACKEND_URL=http://localhost:4232
CORS_ORIGINS=http://localhost:4231,http://127.0.0.1:4231,http://172.25.0.25:4231
