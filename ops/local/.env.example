# ops/local/.env.example
#
# Copy to ops/local/.env and adjust as needed.
#
# This file is used by ops/local/docker-compose.yml (local dev).

# ============================================================================
# R ANALYTICS (Shiny) - Local Container
# ============================================================================
# The compose service maps these R_DB_* values into the app's DB_* environment
# variables. Defaults point to the VPN database used by the legacy R scripts.

R_DB_HOST=10.8.0.2
R_DB_PORT=5433
R_DB_NAME=FRS9PRO
R_DB_SCHEMA=public
R_DB_USER=postgres
R_DB_PASSWORD=postgres

# If you want R Analytics to point at the local Postgres container instead:
# R_DB_HOST=postgres
# R_DB_PORT=5432
# R_DB_NAME=ifrspro_platform_admin
# R_DB_USER=postgres
# R_DB_PASSWORD=postgres

# Shiny/API ports exposed by docker-compose
# Dashboard: host 4236 -> container 4236
# API: host 4241 -> container 4241
R_ANALYTICS_PORT=4236
R_SERVICE_PORT=4241
