# Backend-only overrides for ops/local/docker-compose.yml
# Copy to ops/local/backend.env and adjust values.

# Local backend URL defaults
BACKEND_URL=http://localhost:4232
API_BASE_URL=http://localhost:4232/api
RAPI_BASE_URL=http://localhost:4241/api
CORS_ORIGINS=http://localhost:4231,http://127.0.0.1:4231

# Database Configuration (LOCALDEV)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres

# Platform Database
PLATFORM_DB_HOST=host.docker.internal
PLATFORM_DB_PORT=5433
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=ifrspro_platform_admin
PLATFORM_DB_SSL=false

# Shared Services Database
SHARED_DB_HOST=host.docker.internal
SHARED_DB_PORT=5433
SHARED_DB_USER=postgres
SHARED_DB_PASSWORD=postgres
SHARED_DB_NAME=ifrspro_shared_services
SHARED_DB_SSL=false

# Tenant Database
TENANT_DB_HOST=host.docker.internal
TENANT_DB_PORT=5433
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_NAME=ifrspro_tenant_iaf
TENANT_DB_SSL=false

# Legacy FRS9 Database
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=5433
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=postgres
LEGACY_DB_NAME=FRS9PRO
LEGACY_DB_SSL=false

# Server Configuration
BACKEND_PORT=4232
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_DIR=logs

# Discord alerting (optional)
# Example: https://discord.com/api/webhooks/xxx/yyy
ALERT_DISCORD_WEBHOOK_URL=
ALERT_DISCORD_TIMEOUT_MS=5000
ALERT_MIN_LEVEL=error
ALERT_THROTTLE_MS=60000

# Security Configuration
# IMPORTANT: generate strong unique values per environment
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-32-char-key
SALT_ROUNDS=12

# Approval governance (default: strict no self-approval)
# Only set true if you explicitly allow users with admin.super_admin to approve their own requests.
APPROVAL_ALLOW_SUPERADMIN_SELF_APPROVAL=false

# Approval governance (default: strict level routing)
# If true, users with admin.super_admin can bypass level role/permission routing checks.
APPROVAL_ALLOW_SUPERADMIN_LEVEL_BYPASS=false

# Approval governance (default: strict required approver count)
# If true, users with admin.super_admin can complete requests even when approvalsRequired > approvalsReceived.
APPROVAL_ALLOW_SUPERADMIN_COUNT_BYPASS=false

# Approval workflow acceleration (default: disabled)
# If true, requests created by users with admin.super_admin are auto-approved immediately
# while still creating approval request + action logs.
APPROVAL_AUTO_APPROVE_SUPERADMIN_REQUESTS=false

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10
REDIS_TOKEN_BLACKLIST_DB=4
REDIS_SESSION_DB=11

# Rate Limiting (dev defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
