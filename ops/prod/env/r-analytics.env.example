# R Analytics Environment Variables
# Copy this file to ops/prod/env/r-analytics.env on the production server
# and fill in the actual values.

# --- Deployment ---
NODE_ENV=production
DEPLOYMENT_TARGET=iafecs

# --- Server Configuration ---
# IMPORTANT: Container listens on 4236 (Shiny UI) and 4241 (R API)
R_ANALYTICS_PORT=4236
R_SERVICE_PORT=4241
R_ANALYTICS_HOST=0.0.0.0

# --- Database Connection (Legacy / IFRS9 Pro) ---
# Server IP: 172.25.0.25 | Port: 5432 | Database: FRS9PRO
# Both variable families are set for compatibility (docker-entrypoint.sh prefers FRS9_DB_*)
LEGACY_DB_HOST=172.25.0.25
LEGACY_DB_PORT=5432
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=your_secure_password
LEGACY_DB_NAME=FRS9PRO
LEGACY_DB_SCHEMA=public

# FRS9_DB_* takes priority over DB_* in docker-entrypoint.sh
FRS9_DB_HOST=172.25.0.25
FRS9_DB_PORT=5432
FRS9_DB_USER=postgres
FRS9_DB_PASSWORD=your_secure_password
FRS9_DB_NAME=FRS9PRO
FRS9_DB_SCHEMA=public

# DB_* fallback (used if FRS9_DB_* not set)
DB_HOST=172.25.0.25
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=FRS9PRO
DB_SCHEMA=public

# --- Application Integration ---
BACKEND_URL=https://ristix.bdo-ki.com
API_BASE_URL=https://ristix.bdo-ki.com/api

# --- Public URLs ---
R_ANALYTICS_URL=https://analytics-ristix.bdo-ki.com
R_API_URL=https://analytics-calc-ristix.bdo-ki.com

# --- Tenant Configuration ---
BANKING_TYPE=conventional
TENANT_SLUG=iaf
COMPANY_NAME="Indonesia Airawata Finance"

# --- Security ---
R_ANALYTICS_AUTH_ENABLED=true

# --- Runtime Recovery / Alerting ---
R_ANALYTICS_ALERT_WEBHOOK_URL=
R_ANALYTICS_ALERT_WEBHOOK_TIMEOUT=8

# --- Internal watchdog tuning ---
R_ANALYTICS_HEALTHCHECK_INTERVAL=20
R_ANALYTICS_HEALTHCHECK_TIMEOUT=5
R_ANALYTICS_HEALTHCHECK_FAILURES=3
R_ANALYTICS_STARTUP_GRACE_PERIOD=120
